# 复制为 .env 使用（.gitignore 已忽略）
DASHSCOPE_API_KEY=sk-xxxx
EMBEDDING_PROVIDER=dashscope        # dashscope | mock
QWEN_EMBEDDING_MODEL=text-embedding-v3
EMBED_DIMENSIONS=1024
VLM_ENABLED=0                        # 1 时红页走 Qwen-VL 转录（需 Key）

# 对话 LLM（M3，DashScope OpenAI 兼容，与 embedding 同 Key）
QWEN_LLM_MODEL=qwen-plus
QA_CONFIDENCE_THRESHOLD=0.6
QA_MAX_RETRY=2
QA_HISTORY_ROUNDS=10

# Redis checkpointer（F4.1；不可达自动降级内存并明示）
REDIS_URL=redis://localhost:6379/0
REDIS_CHECKPOINTER_ENABLED=1

# M4 API 服务
HOST=127.0.0.1
PORT=8000
SERVICE_API_KEY=                    # 留空 = 关闭鉴权（仅本地 demo）；生产必须配置
API_MAX_INFLIGHT=50                 # 并发在途问答上限（超限 429 RATE_LIMITED）
SSE_PING_INTERVAL_S=15              # SSE 空闲保活间隔
INGEST_WORKERS=1                    # 入库线程数（Chroma 并发写限制 → 保持 1 单写者）
DEFAULT_TENANT_ID=tenant_demo

# M5 观测
LOG_FORMAT=json                     # json（生产，日志采集）| text（本地调试）
OBS_SLOW_QUERY_MS=500               # 检索慢查询阈值
OBS_SLOW_LLM_MS=3000                # LLM 往返慢阈值
OBS_SLOW_INGEST_MS=5000             # 入库慢阈值

